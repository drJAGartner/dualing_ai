# Backend HTTP port.
PORT=3000

# Agent HTTP ports. Each agent must listen on its configured port inside the container.
LEFT_AGENT_PORT=8101
RIGHT_AGENT_PORT=8102

# Agent prompt timeout. Lucy can take 30-120s for realistic turns.
PROMPT_TIMEOUT_MS=180000

# Optional Docker env file passed into both agent containers.
# Use this for Lucy credentials/config, after sanitizing quotes and inline comments.
# AGENT_ENV_FILE=./lucy.env
# LEFT_AGENT_ENV_FILE=./left.env
# RIGHT_AGENT_ENV_FILE=./right.env

# Optional internal container ports. Useful for images that always listen on a fixed port.
# Do not set these for the Lucy wrapper images in left/ and right/; the adapter
# listens on the injected PORT and forwards to Lucy's internal ADK server.
# LEFT_AGENT_CONTAINER_PORT=8101
# RIGHT_AGENT_CONTAINER_PORT=8102
